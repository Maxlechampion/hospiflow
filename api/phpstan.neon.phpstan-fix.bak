includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/factories/
        - database/seeders/

    level: 5

    ignoreErrors:
        # Eloquent magic methods (where, find, create, etc.)
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::.*#'
        - '#Call to an undefined static method App\\Models\\.*::.*#'
        # Property access dynamique sur les modèles
        - '#Access to an undefined property .*::\$.*#'
        # Relations polymorphes
        - '#Parameter \#1 \$.* of method .* expects .* given\.#'

    excludePaths:
        - app/Http/Controllers/AuthController.php
        - database/migrations/
        - tests/

    treatPhpDocTypesAsCertain: false
