<?php

namespace Database\Factories;

use App\Models\Drug;
use App\Models\DrugLot;
use App\Models\Facility;
use Illuminate\Database\Eloquent\Factories\Factory;

class DrugLotFactory extends Factory
{
    protected $model = DrugLot::class;

    public function definition(): array
    {
        return [
            'facility_id' => Facility::factory(),
            'drug_id' => Drug::factory(),
            'lot_number' => strtoupper($this->faker->bothify('LOT-####??')),
            'quantity' => $this->faker->numberBetween(10, 500),
            'expires_at' => now()->addMonths($this->faker->numberBetween(3, 24)),
        ];
    }
}
