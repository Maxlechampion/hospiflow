includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/factories/
        - database/seeders/

    level: 5

    ignoreErrors:
        # PHPStan ne peut pas inferer le type des callbacks Collection::map() sur Eloquent
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*::map\(\) contains unresolvable type\.#'

        # Methodes magiques Eloquent (where, find, create, etc.)
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\.*::.*#'

        # withTrashed sur HasMany (PHPStan ne reconnait pas les macros SoftDeletes)
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::withTrashed\(\)\.#'

        # Proprietes dynamiques Eloquent
        - '#Access to an undefined property .*::\$.*#'

        # Helpers de factories : PHPStan ne voit pas l'usage via $this->xxx()
        - '#Method Database\\Factories\\.*::(randLetters|randDigits|randPhone|randFrom)\(\) is unused\.#'

    excludePaths:
        - app/Http/Controllers/AuthController.php
        - database/migrations/
        - tests/

    treatPhpDocTypesAsCertain: false
